# ========================
# App
# ========================
NODE_ENV=development
PORT=8000

# ========================
# Database
# ========================
DATABASE_URL=postgresql://streamvault:streamvault_secret@localhost:5432/streamvault_db
DIRECT_DATABASE_URL=postgresql://streamvault:streamvault_secret@localhost:5432/streamvault_db

# ========================
# Redis
# ========================
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379

# ========================
# JWT Auth
# ========================
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_REFRESH_SECRET=your_super_secret_refresh_key_change_this
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ========================
# Object Storage (MinIO / S3)
# ========================
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=streamvault_admin
MINIO_SECRET_KEY=streamvault_minio_secret
MINIO_RAW_BUCKET=streamvault-raw
MINIO_HLS_BUCKET=streamvault-hls
MINIO_THUMBNAILS_BUCKET=streamvault-thumbnails

# For AWS S3 (production)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=ap-south-1
# AWS_S3_BUCKET=streamvault-prod
# CLOUDFRONT_DOMAIN=https://d1234567890.cloudfront.net
# CLOUDFRONT_KEY_PAIR_ID=
# CLOUDFRONT_PRIVATE_KEY=

# ========================
# Search
# ========================
MEILI_HOST=http://localhost:7700
MEILI_API_KEY=streamvault_meili_master_key

# ========================
# Transcoder Service
# ========================
TRANSCODER_URL=http://localhost:8001
TRANSCODER_SECRET=internal_transcoder_secret

# ========================
# Payments (Stripe)
# ========================
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
STRIPE_PREMIUM_PRICE_ID=price_your_premium_monthly_price_id
STRIPE_PREMIUM_ANNUAL_PRICE_ID=price_your_premium_annual_price_id
STRIPE_PLATFORM_FEE_PERCENT=30

# ========================
# OAuth (Google)
# ========================
GOOGLE_CLIENT_ID=your_google_oauth_client_id
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret
GOOGLE_CALLBACK_URL=http://localhost:8000/auth/google/callback

# ========================
# OpenAI (auto-tagging)
# ========================
OPENAI_API_KEY=sk-your_openai_api_key

# ========================
# RTMP Server
# ========================
RTMP_HOST=localhost
RTMP_PORT=1935

# ========================
# Frontend
# ========================
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000
NEXT_PUBLIC_RTMP_URL=rtmp://localhost:1935/live
NEXT_PUBLIC_HLS_CDN_URL=http://localhost:9000/streamvault-hls
NEXT_PUBLIC_THUMBNAIL_CDN_URL=http://localhost:9000/streamvault-thumbnails
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your_google_oauth_client_id

# ========================
# Email (optional)
# ========================
RESEND_API_KEY=re_your_resend_api_key
EMAIL_FROM=noreply@streamvault.dev
